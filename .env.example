# =============================================================================
# Data Pipeline Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Kafka Configuration
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRADES_TOPIC=trades_topic
TRADES_GROUP_ID=trade_consumer_group

# -----------------------------------------------------------------------------
# AWS S3 Configuration (for consumer uploads to landing bucket)
# -----------------------------------------------------------------------------
# For local development with Floci emulator:
#   AWS_ACCESS_KEY_ID=test
#   AWS_SECRET_ACCESS_KEY=test
#   AWS_ENDPOINT_URL=http://floci:4566   (container-to-container)
#   AWS_ENDPOINT_URL=http://localhost:4566   (host CLI tools)
#
# For production (real AWS):
#   AWS_ACCESS_KEY_ID=your_access_key
#   AWS_SECRET_ACCESS_KEY=your_secret_key
#   AWS_ENDPOINT_URL=  (leave empty or remove)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://floci:4566
S3_BUCKET=landing-bucket
S3_PREFIX=trades
DELETE_LOCAL_AFTER_UPLOAD=false

# -----------------------------------------------------------------------------
# Floci AWS Emulator Configuration
# -----------------------------------------------------------------------------
# Storage modes: memory (ephemeral), hybrid (default), persistent, wal
FLOCI_STORAGE_MODE=hybrid

# -----------------------------------------------------------------------------
# Consumer Configuration
# -----------------------------------------------------------------------------
FLUSH_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# Producer Configuration (for local testing)
# -----------------------------------------------------------------------------
TRADE_COUNT=10000
TRADE_DELAY=0.02
TRADES_SCHEMA_PATH=configs/schemas/trade_schema.avsc
